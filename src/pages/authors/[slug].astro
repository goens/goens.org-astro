---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author: author.data },
  }));
}

const { author } = Astro.props;

// Resolve paper keys → publication data, sorted newest first
const allPubs = await getCollection("publications");
const pubMap = Object.fromEntries(allPubs.map((p) => [p.id, p.data]));
const papers = author.papers
  .map((key) => pubMap[key])
  .filter(Boolean)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
---

<Base
  title={`${author.name} — Andrés Goens`}
  description={`Publications by ${author.name}`}
  canonicalPath={`/authors/${author.slug}`}
>
  <div class="prose">
    <h1>{author.name}</h1>
    {author.bio && <p class="lead">{author.bio}</p>}
    {author.homepage && (
      <p>
        <a href={author.homepage} rel="noopener noreferrer" target="_blank">
          Homepage
        </a>
      </p>
    )}
    <p class="lead">{papers.length} publication{papers.length !== 1 ? "s" : ""}</p>
  </div>

  <ol class="pub-list" reversed>
    {
      papers.map((pub) => (
        <li class="pub-item">
          <span class="pub-venue">{pub.venue}</span>
          <a class="pub-title" href={`/publications/${pub.key}`}>
            {pub.title}
          </a>
          <p class="pub-authors">
            {pub.authors.map((a, i) => (
              <>
                <a href={`/authors/${a.slug}`}>{a.name}</a>
                {i < pub.authors.length - 1 ? ", " : ""}
              </>
            ))}
          </p>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .pub-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pub-item {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-venue {
    font-size: 0.8em;
    font-weight: 600;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pub-title {
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.4;
  }

  .pub-title:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .pub-authors {
    margin: 0;
    font-size: 0.9em;
    color: var(--muted);
  }

  .pub-authors a {
    color: var(--muted);
    text-decoration: none;
  }

  .pub-authors a:hover {
    color: var(--link);
    text-decoration: underline;
  }
</style>
