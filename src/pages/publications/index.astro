---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const all = await getCollection("publications");
const publications = all
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
---

<Base
  title="Publications — Andrés Goens"
  description="Research publications and papers."
  canonicalPath="/publications"
>
  <div class="prose">
    <h1>Publications</h1>
    <p class="lead">Papers, preprints, and other research output.</p>
  </div>

  <ol class="pub-list" reversed>
    {
      publications.map((pub) => (
        <li class="pub-item">
          <span class="pub-venue">{pub.venue}</span>
          <a class="pub-title" href={`/publications/${pub.key}`}>
            {pub.title}
          </a>
          <p class="pub-authors">
            {pub.authors.map((a, i) => (
              <>
                <a href={`/authors/${a.slug}`}>{a.name}</a>
                {i < pub.authors.length - 1 ? ", " : ""}
              </>
            ))}
          </p>
          <div class="pub-links">
            {pub.pdf && (
              <a class="pub-link-btn" href={pub.pdf} target="_blank" rel="noopener noreferrer" title="Download PDF">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
                PDF
              </a>
            )}
            {pub.doi && (
              <a class="pub-link-btn" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" title="View via DOI">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
                DOI
              </a>
            )}
            {pub.artifact && (
              <a class="pub-link-btn" href={`https://doi.org/${pub.artifact}`} target="_blank" rel="noopener noreferrer" title="View artifact">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                </svg>
                Artifact
              </a>
            )}
            {pub.repository && (
              <a class="pub-link-btn" href={pub.repository} target="_blank" rel="noopener noreferrer" title="View repository">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
                </svg>
                Repository
              </a>
            )}
            {pub.bibtex && (
              <button class="pub-link-btn pub-bibtex-toggle" aria-expanded="false" aria-controls={`bibtex-panel-${pub.key}`} title="Show BibTeX">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                </svg>
                BibTeX
              </button>
            )}
          </div>
          {pub.bibtex && (
            <div class="pub-bibtex-panel" id={`bibtex-panel-${pub.key}`} hidden>
              <div class="pub-bibtex-body">
                <pre><code id={`bibtex-${pub.key}`}>{pub.bibtex}</code></pre>
                <button class="pub-copy-btn" data-target={`bibtex-${pub.key}`}>Copy</button>
              </div>
            </div>
          )}
        </li>
      ))
    }
  </ol>
</Base>

<script>
  // BibTeX toggle
  document.querySelectorAll<HTMLButtonElement>(".pub-bibtex-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const panelId = btn.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
      btn.classList.toggle("is-active", !open);
    });
  });

  // Copy BibTeX
  document.querySelectorAll<HTMLButtonElement>(".pub-copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.target;
      const el = target ? document.getElementById(target) : null;
      if (!el) return;
      navigator.clipboard.writeText(el.textContent ?? "").then(() => {
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = "Copy"; }, 2000);
      });
    });
  });
</script>

<style>
  .pub-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pub-item {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-venue {
    font-size: 0.8em;
    font-weight: 600;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pub-title {
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.4;
  }

  .pub-title:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .pub-authors {
    margin: 0;
    font-size: 0.9em;
    color: var(--muted);
  }

  .pub-authors a {
    color: var(--muted);
    text-decoration: none;
  }

  .pub-authors a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 2px;
  }

  .pub-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78em;
    font-weight: 600;
    color: var(--accent-dark);
    background: var(--highlight);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 2px 8px;
    text-decoration: none;
    cursor: pointer;
  }

  .pub-link-btn:hover,
  .pub-link-btn.is-active {
    background: var(--accent);
    color: var(--fg);
  }

  .pub-link-btn svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .pub-bibtex-panel {
    margin-top: var(--space-1);
  }

  .pub-bibtex-body {
    position: relative;
  }

  .pub-bibtex-body pre {
    font-size: 0.8em;
    background: var(--highlight);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: var(--space-3);
    overflow-x: auto;
    margin: 0;
  }

  .pub-bibtex-body code {
    font-family: var(--font-mono);
  }

  .pub-copy-btn {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    font-size: 0.75em;
    font-weight: 600;
    color: var(--accent-dark);
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 2px 8px;
    cursor: pointer;
  }

  .pub-copy-btn:hover {
    background: var(--accent);
    color: var(--fg);
  }
</style>
