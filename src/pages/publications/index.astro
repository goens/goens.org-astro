---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PubLinks from "../../components/PubLinks.astro";

const RESEARCH_TYPES = new Set(["article", "inproceedings", "phdthesis", "inbook"]);

const all = await getCollection("publications");
const sorted = all
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));

const researchPubs = sorted.filter((p) => RESEARCH_TYPES.has(p.type));
const theses = sorted.filter((p) => !RESEARCH_TYPES.has(p.type));

const recentPubs = researchPubs.slice(0, 10);
const recentTheses = theses.slice(0, 10);
---

<Base
  title="Publications — PRS Group"
  description="Research publications and papers."
  canonicalPath="/publications"
>
  <section>
    <div class="section-header prose">
      <h1>Publications</h1>
      {researchPubs.length > 10 && <a href="/publications/all">All publications →</a>}
    </div>
    <ol class="pub-list">
      {
        recentPubs.map((pub) => (
          <li class="pub-item">
            <span class="pub-venue">{pub.venue}</span>
            <a class="pub-title" href={`/publications/${pub.key}`}>
              {pub.title}
            </a>
            <p class="pub-authors">
              {pub.authors.map((a, i) => (
                <>
                  <a href={`/authors/${a.slug}`}>{a.name}</a>
                  {i < pub.authors.length - 1 ? ", " : ""}
                </>
              ))}
            </p>
            <PubLinks pub={pub} />
          </li>
        ))
      }
    </ol>
    {researchPubs.length > 10 && (
      <p class="see-all"><a href="/publications/all">All {researchPubs.length} publications →</a></p>
    )}
  </section>

  <section class="theses-section">
    <div class="section-header">
      <h2>B.Sc/M.Sc./Diploma Theses</h2>
      {theses.length > 10 && <a href="/publications/theses">All theses →</a>}
    </div>
    {theses.length === 0 ? (
      <p class="empty-note">No theses listed yet.</p>
    ) : (
      <>
        <ol class="pub-list">
          {
            recentTheses.map((pub) => (
              <li class="pub-item">
                <span class="pub-venue">{pub.venue}</span>
                <a class="pub-title" href={`/publications/${pub.key}`}>
                  {pub.title}
                </a>
                <p class="pub-authors">
                  {pub.authors.map((a, i) => (
                    <>
                      <a href={`/authors/${a.slug}`}>{a.name}</a>
                      {i < pub.authors.length - 1 ? ", " : ""}
                    </>
                  ))}
                </p>
                <PubLinks pub={pub} />
              </li>
            ))
          }
        </ol>
        {theses.length > 10 && (
          <p class="see-all"><a href="/publications/theses">All {theses.length} theses →</a></p>
        )}
      </>
    )}
  </section>
</Base>

<style>
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .section-header h1,
  .section-header h2 {
    margin: 0;
  }

  .section-header a {
    font-size: 0.875em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .section-header a:hover {
    color: var(--link);
  }

  .theses-section {
    margin-top: var(--space-6);
  }

  .pub-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pub-item {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-venue {
    font-size: 0.8em;
    font-weight: 600;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pub-title {
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.4;
  }

  .pub-title:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .pub-authors {
    margin: 0;
    font-size: 0.9em;
    color: var(--muted);
  }

  .pub-authors a {
    color: var(--muted);
    text-decoration: none;
  }

  .pub-authors a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .see-all {
    margin-top: var(--space-4);
    font-size: 0.9em;
  }

  .see-all a {
    color: var(--muted);
    text-decoration: none;
  }

  .see-all a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .empty-note {
    color: var(--muted);
    font-style: italic;
    margin-top: var(--space-3);
  }
</style>
