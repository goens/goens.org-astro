---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PubLinks from "../../components/PubLinks.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map((pub) => ({
    params: { slug: pub.id },
    props: { pub: pub.data },
  }));
}

const { pub } = Astro.props;

function youtubeEmbedUrl(url: string): string | null {
  const match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  return match ? `https://www.youtube.com/embed/${match[1]}` : null;
}

const videoEmbedUrl = pub.video ? youtubeEmbedUrl(pub.video) : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: pub.title,
  author: pub.authors.map((a) => ({ "@type": "Person", name: a.name })),
  datePublished: String(pub.year),
  ...(pub.doi && { identifier: { "@type": "PropertyValue", propertyID: "doi", value: pub.doi } }),
};
---

<Base
  title={`${pub.title} — PRS Publications`}
  description={pub.abstract || `${pub.venue} ${pub.year}`}
  canonicalPath={`/publications/${pub.key}`}
  jsonLd={jsonLd}
>
  <article class="pub-detail prose">
    <p class="pub-meta">
      <span class="pub-venue">{pub.venue}</span>
      <span class="pub-year">{pub.year}</span>
    </p>

    <h1>{pub.title}</h1>

    <p class="pub-authors">
      {
        pub.authors.map((a, i) => (
          <>
            <a href={`/authors/${a.slug}`}>{a.name}</a>
            {i < pub.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </p>

    <PubLinks pub={pub} />

    {
      videoEmbedUrl && (
        <section class="pub-video">
          <h2>Presentation</h2>
          <div class="pub-video-wrapper">
            <iframe
              src={videoEmbedUrl}
              title="Presentation video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
        </section>
      )
    }

    {
      pub.abstract && (
        <section class="pub-abstract">
          <h2>Abstract</h2>
          <p>{pub.abstract}</p>
        </section>
      )
    }

    <p class="pub-back">
      <a href="/publications">← All publications</a>
    </p>
  </article>
</Base>

<style>
  .pub-detail {
    max-width: 70ch;
  }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .pub-venue {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--highlight);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .pub-year {
    font-size: 0.9em;
    color: var(--muted);
  }

  .pub-detail h1 {
    margin-bottom: var(--space-3);
  }

  .pub-authors {
    font-size: 0.95em;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .pub-authors a {
    color: var(--muted);
    text-decoration: none;
  }

  .pub-authors a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .pub-video {
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
    margin-top: var(--space-2);
  }

  .pub-video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 4px;
  }

  .pub-video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pub-abstract {
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
    margin-top: var(--space-2);
  }

  .pub-back {
    margin-top: var(--space-5);
    font-size: 0.9em;
  }

  .pub-back a {
    color: var(--muted);
    text-decoration: none;
  }

  .pub-back a:hover {
    color: var(--link);
  }
</style>
