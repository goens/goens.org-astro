---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PubLinks from "../../components/PubLinks.astro";

const RESEARCH_TYPES = new Set(["article", "inproceedings", "phdthesis"]);

const all = await getCollection("publications");
const publications = all
  .map((p) => p.data)
  .filter((p) => RESEARCH_TYPES.has(p.type))
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
---

<Base
  title="All Publications — Andrés Goens"
  description="All research publications and papers."
  canonicalPath="/publications/all"
>
  <div class="prose">
    <h1>Publications</h1>
    <p class="lead">All papers, preprints, and research output.</p>
  </div>

  <ol class="pub-list" reversed>
    {
      publications.map((pub) => (
        <li class="pub-item">
          <span class="pub-venue">{pub.venue}</span>
          <a class="pub-title" href={`/publications/${pub.key}`}>
            {pub.title}
          </a>
          <p class="pub-authors">
            {pub.authors.map((a, i) => (
              <>
                <a href={`/authors/${a.slug}`}>{a.name}</a>
                {i < pub.authors.length - 1 ? ", " : ""}
              </>
            ))}
          </p>
          <PubLinks pub={pub} />
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .pub-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pub-item {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-venue {
    font-size: 0.8em;
    font-weight: 600;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pub-title {
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.4;
  }

  .pub-title:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .pub-authors {
    margin: 0;
    font-size: 0.9em;
    color: var(--muted);
  }

  .pub-authors a {
    color: var(--muted);
    text-decoration: none;
  }

  .pub-authors a:hover {
    color: var(--link);
    text-decoration: underline;
  }
</style>
