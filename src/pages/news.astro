---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

const all = await getCollection("news");
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
}
---

<Base title="News — Andrés Goens" description="Latest news and updates." canonicalPath="/news">
  <div class="prose">
    <h1>News</h1>
    <p class="lead">Recent updates, announcements, and events.</p>
  </div>

  {posts.length === 0 ? (
    <p>Nothing here yet — check back soon.</p>
  ) : (
    <ol class="news-list">
      {posts.map((post) => (
        <li class="news-item">
          {post.data.thumbnail && (
            <Image class="news-thumb" src={post.data.thumbnail} alt="" aria-hidden="true" width="80" height="60" />
          )}
          <div class="news-body">
            <time class="news-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <a class="news-title" href={`/news/${post.id}`}>{post.data.title}</a>
          </div>
        </li>
      ))}
    </ol>
  )}
</Base>

<style>
  .news-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .news-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    border-left: 3px solid var(--accent);
    padding-left: var(--space-3);
  }

  .news-thumb {
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .news-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .news-date {
    font-size: 0.8em;
    font-weight: 600;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .news-title {
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    line-height: 1.4;
  }

  .news-title:hover {
    color: var(--link);
    text-decoration: underline;
  }
</style>
